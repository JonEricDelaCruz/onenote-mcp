# OneNote MCP server configuration
# Copy to .env and fill in ONENOTE_CLIENT_ID. Everything else is optional.
#
# .env is gitignored. Never commit real values.

# ---------------------------------------------------------------- required ---

# Microsoft application (client) ID.
#
# You may not need this at all: if this build ships a built-in application ID,
# leave it blank and everything works. Run `npm run doctor` to see which applies.
#
# Set it if you need to use your own app registration (some organizations
# require this). Create one free at https://entra.microsoft.com:
#   App registrations -> New registration
#   Account type: "Any organizational directory and personal Microsoft accounts"
#   Authentication -> Add a platform -> Mobile and desktop applications
#   Redirect URI: http://localhost
#
# Easiest path: run `npm run setup`, which walks you through it.
ONENOTE_CLIENT_ID=

# ---------------------------------------------------------------- optional ---

# Directory (tenant) to sign in against.
#   common        both personal and work/school accounts (default)
#   consumers     personal Microsoft accounts only
#   organizations work/school accounts only
#   <tenant-guid> a specific tenant, required if your app is single-tenant
# ONENOTE_TENANT_ID=common

# Graph scopes, space or comma separated.
# Default is least-privilege for your own notebooks:
#   Notes.ReadWrite offline_access
# Use the .All variants only if you need notebooks shared with you or group
# notebooks -- they grant considerably broader access:
#   Notes.ReadWrite.All offline_access
# For a read-only server:
#   Notes.Read offline_access
# ONENOTE_SCOPES=Notes.ReadWrite offline_access

# Disable all write tools (createPage, appendToPage, createSection, deletePage).
# Recommended if you only want the assistant to read your notes.
# ONENOTE_ALLOW_WRITE=false

# Where to cache credentials. Defaults to your OS config directory, outside this
# repo, created 0700 with the cache file at 0600:
#   macOS   ~/Library/Application Support/onenote-mcp/token-cache.json
#   Linux   ~/.config/onenote-mcp/token-cache.json
#   Windows %APPDATA%\onenote-mcp\token-cache.json
# ONENOTE_TOKEN_CACHE=

# Pin the loopback redirect port. Leave unset to let the OS pick a free port
# (works with a plain http://localhost redirect URI registration). If you set
# this, register http://localhost:PORT on your app exactly.
# ONENOTE_REDIRECT_PORT=3000

# Opt in to device code flow instead of the browser-based PKCE flow.
#
# WARNING: since 2026-07-01 all new Microsoft Entra tenants block device code
# flow by default under security defaults, and many existing tenants block it
# via Conditional Access. Only enable this for a headless host whose tenant
# permits it.
# ONENOTE_ALLOW_DEVICE_CODE=true

# Print stack traces from the CLI.
# ONENOTE_DEBUG=1

# Ignore this .env file entirely. Useful when your MCP client passes environment
# variables directly and you want fully predictable configuration.
# ONENOTE_SKIP_DOTENV=1
